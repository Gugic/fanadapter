{
  "name": "tinyusb",
  "version": "0.18.0",
  "description": "TinyUSB host/device stack — trimmed to the Synopsys dwc2 driver for STM32H7",
  "keywords": "usb, host, device",
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "srcFilter": [
      "-<*>",
      "+<*.c>",
      "+<common/>",
      "+<device/>",
      "+<host/>",
      "+<class/>",
      "+<portable/synopsys/dwc2/>"
    ],
    "flags": [
      "-DCFG_TUSB_MCU=OPT_MCU_STM32H7"
    ]
  }
}
