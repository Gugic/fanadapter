<UserControl x:Class="Fanadapter.SimHub.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="0,0,0,16">

            <styles:SHSection Title="ADAPTER" ShowSeparator="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Ports}"
                                  SelectedItem="{Binding SelectedPort}"
                                  DisplayMemberPath="Description"
                                  MinWidth="280"
                                  VerticalAlignment="Center" />
                        <styles:SHButtonSecondary Command="{Binding RefreshPortsCommand}"
                                                  Margin="8,0,0,0">Refresh</styles:SHButtonSecondary>
                        <styles:SHButtonPrimary Command="{Binding ConnectCommand}"
                                                Margin="8,0,0,0">Connect</styles:SHButtonPrimary>
                        <styles:SHButtonSecondary Command="{Binding DisconnectCommand}"
                                                  Margin="8,0,0,0">Disconnect</styles:SHButtonSecondary>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding FirmwareBadge}" Opacity="0.7" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding DirectOutputNote}" Opacity="0.7" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <styles:SHButtonPrimary Command="{Binding SaveCommand}">Save to adapter</styles:SHButtonPrimary>
                        <styles:SHButtonSecondary Command="{Binding ResetCommand}"
                                                  Margin="8,0,0,0">Reset to defaults</styles:SHButtonSecondary>
                        <styles:SHButtonSecondary Command="{Binding RebootCommand}"
                                                  Margin="8,0,0,0">Reboot adapter</styles:SHButtonSecondary>
                    </StackPanel>

                    <TextBlock Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                               Text="Changes apply to the adapter immediately but live in its RAM until saved. Reset also only takes effect after a save." />
                </StackPanel>
            </styles:SHSection>

            <styles:SHTabControl>
                <styles:SHTabItem Header="SimHub drive">
                    <StackPanel Margin="8">

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="For controllers plugged into this PC. SimHub captures and maps them; this plugin sends the result straight to the wheelbase, overriding whatever the adapter's own USB devices are doing on those channels." />

                        <styles:SHSubSection Title="Shifter and buttons">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                                           Text="Hold bindings engage a gear while the control is held and return to neutral on release — real H-pattern behaviour. Select bindings latch instead, for a button that should stay in gear." />

                                <ui:ControlsEditor ActionName="FanadapterPlugin.ShiftUp" FriendlyName="Shift up" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.ShiftDown" FriendlyName="Shift down" />

                                <styles:SHSectionSeparator />

                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGearR" FriendlyName="Hold reverse" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear1" FriendlyName="Hold 1st" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear2" FriendlyName="Hold 2nd" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear3" FriendlyName="Hold 3rd" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear4" FriendlyName="Hold 4th" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear5" FriendlyName="Hold 5th" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear6" FriendlyName="Hold 6th" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.HoldGear7" FriendlyName="Hold 7th" />

                                <styles:SHSectionSeparator />

                                <ui:ControlsEditor ActionName="FanadapterPlugin.SelectGearN" FriendlyName="Select neutral" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.ReleaseOutputs" FriendlyName="Release outputs to the adapter" />
                                <ui:ControlsEditor ActionName="FanadapterPlugin.RearmPedals" FriendlyName="Re-arm the pedal handshake" />
                            </StackPanel>
                        </styles:SHSubSection>

                        <styles:SHSectionSeparator />

                        <styles:SHSubSection Title="Pedals">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                                           Text="Pick the SimHub property carrying each pedal — any controller axis SimHub publishes, or your own NCalc expression. Set the range to match the property (0–100 for SimHub's own axis properties) and watch the live column to check direction." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Find property" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding PropertyFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                             MinWidth="240" VerticalAlignment="Center" />
                                    <styles:SHButtonSecondary Command="{Binding RefreshPropertyListCommand}"
                                                              Margin="8,0,0,0">Reload list</styles:SHButtonSecondary>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding AxisSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,0,0,10" Margin="0,0,0,10"
                                                    BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                                                   Width="90" VerticalAlignment="Center" />
                                                        <ComboBox IsEditable="True" MinWidth="300"
                                                                  ItemsSource="{Binding DataContext.AvailableProperties,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  Text="{Binding PropertyName, UpdateSourceTrigger=LostFocus}"
                                                                  VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="90,0,0,0">
                                                        <TextBlock Text="Range" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Text="{Binding InputMin}" Width="70" VerticalAlignment="Center" />
                                                        <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                                                        <TextBox Text="{Binding InputMax}" Width="70" VerticalAlignment="Center" />
                                                        <styles:SHToggleCheckbox IsChecked="{Binding Invert}"
                                                                                 VerticalAlignment="Center" Margin="16,0,0,0">Invert</styles:SHToggleCheckbox>
                                                        <TextBlock Text="{Binding RawText}" VerticalAlignment="Center"
                                                                   Margin="24,0,0,0" Opacity="0.7" MinWidth="120" />
                                                        <TextBlock Text="{Binding ScaledText}" VerticalAlignment="Center"
                                                                   Margin="8,0,0,0" FontWeight="Bold" MinWidth="60" />
                                                        <ProgressBar Value="{Binding ScaledPercent, Mode=OneWay}" Maximum="100"
                                                                     Width="120" Height="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <styles:SHButtonPrimary Command="{Binding ToggleStreamingCommand}"
                                                            Content="{Binding StreamingButtonText}" />
                                    <styles:SHButtonSecondary Command="{Binding ReleaseOutputsCommand}"
                                                              Margin="8,0,0,0">Release outputs</styles:SHButtonSecondary>
                                </StackPanel>

                                <TextBlock Text="{Binding StreamingStatus}" Margin="0,8,0,0" TextWrapping="Wrap" />

                                <TextBlock Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="Overrides are sticky: the adapter holds the last values it was sent until they are released. The plugin releases automatically when it stops, but 'Release outputs' is there if something ends up stuck." />
                            </StackPanel>
                        </styles:SHSubSection>

                    </StackPanel>
                </styles:SHTabItem>

                <styles:SHTabItem Header="Devices">
                    <StackPanel Margin="8">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Devices plugged into the adapter's own USB hub. Windows cannot see these at all, so this is the only place to check whether the adapter is receiving an input. Values stay at zero until something moves — the adapter only reports inputs when they change." />
                        <TextBlock Text="{Binding DevicesSummary}" Opacity="0.7" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="#33FFFFFF" CornerRadius="3"
                                            Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Identity}" Opacity="0.6" FontSize="11" />
                                            <TextBlock Text="{Binding Summary}" Opacity="0.6" FontSize="11"
                                                       Margin="0,0,0,8" />

                                            <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="26" Height="22" Margin="0,0,3,3"
                                                                CornerRadius="2" BorderThickness="1"
                                                                BorderBrush="#33FFFFFF">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                            <Setter Property="Background" Value="#FF3D8BFD" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Axes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                            <TextBlock Text="{Binding Label}" Width="60"
                                                                       FontSize="11" VerticalAlignment="Center" />
                                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                                         Width="220" Height="10" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Raw}" Width="60" FontSize="11"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       TextAlignment="Right" />
                                                            <TextBlock Text="{Binding ObservedMax, StringFormat=' / {0} seen'}"
                                                                       FontSize="11" Opacity="0.5"
                                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding HasHat, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Hat" Width="60" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding HatText}" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding HasKeyboard, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Keys" Width="60" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding KeysText}" FontFamily="Consolas"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </styles:SHTabItem>

                <styles:SHTabItem Header="Mappings">
                    <StackPanel Margin="8">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Bind devices on the adapter's USB hub to wheelbase outputs. These mappings live on the adapter and keep working with the PC switched off — they are separate from the SimHub drive tab." />

                        <styles:SHSubSection Title="Shifter mode">
                            <StackPanel>
                                <styles:SHToggleCheckbox IsChecked="{Binding IsLatchMode}">Latch gears instead of holding</styles:SHToggleCheckbox>
                                <TextBlock Text="{Binding GearModeExplanation}" TextWrapping="Wrap"
                                           Opacity="0.7" Margin="0,4,0,0" />
                            </StackPanel>
                        </styles:SHSubSection>

                        <styles:SHSectionSeparator />

                        <ItemsControl ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10"
                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" MinWidth="110" />
                                            <TextBlock Text="{Binding Group}" Opacity="0.5" FontSize="11"
                                                       VerticalAlignment="Center" MinWidth="130" />
                                            <TextBlock Text="{Binding SummaryText}" Opacity="0.5" FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding VisibleSlots}" Margin="12,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Description}" MinWidth="110"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DeviceText}" Opacity="0.5" FontSize="11"
                                                                       MinWidth="80" VerticalAlignment="Center" />

                                                            <styles:SHButtonSecondary
                                                                Command="{Binding DataContext.StartCaptureCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                CommandParameter="{Binding}">Listen</styles:SHButtonSecondary>

                                                            <styles:SHLinkButtonSmall Margin="6,0,0,0"
                                                                Command="{Binding DataContext.ClearBindingCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsBound, Converter={StaticResource BoolToVisibility}}">Clear</styles:SHLinkButtonSmall>

                                                            <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0"
                                                                       VerticalAlignment="Center" FontWeight="Bold" />

                                                            <ProgressBar Value="{Binding LiveProcessedPercent, Mode=OneWay}"
                                                                         Maximum="100" Width="120" Height="10"
                                                                         Margin="10,0,0,0" VerticalAlignment="Center"
                                                                         Visibility="{Binding IsBound, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                    Visibility="{Binding IsAxis, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Raw" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                                                            <TextBox Text="{Binding RawMin}" Width="60" VerticalAlignment="Center" />
                                                            <TextBlock Text="to" VerticalAlignment="Center" Margin="4,0" FontSize="11" />
                                                            <TextBox Text="{Binding RawMax}" Width="60" VerticalAlignment="Center" />

                                                            <TextBlock Text="Deadzone" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11" />
                                                            <TextBox Text="{Binding DeadzoneLow}" Width="60" VerticalAlignment="Center" />
                                                            <TextBlock Text="to" VerticalAlignment="Center" Margin="4,0" FontSize="11" />
                                                            <TextBox Text="{Binding DeadzoneHigh}" Width="60" VerticalAlignment="Center" />

                                                            <styles:SHToggleCheckbox IsChecked="{Binding Invert}"
                                                                                     Margin="12,0,0,0" VerticalAlignment="Center">Invert</styles:SHToggleCheckbox>

                                                            <TextBlock Text="{Binding LiveRaw, StringFormat='raw {0}'}"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                                       Opacity="0.6" FontSize="11" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                    Visibility="{Binding ShowThreshold, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Press above" VerticalAlignment="Center"
                                                                       Margin="0,0,4,0" FontSize="11" />
                                                            <TextBox Text="{Binding Threshold}" Width="70" VerticalAlignment="Center" />
                                                            <TextBlock Text="(0–65535, after scaling)" VerticalAlignment="Center"
                                                                       Margin="6,0,0,0" Opacity="0.5" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </styles:SHTabItem>

                <styles:SHTabItem Header="Outputs">
                    <StackPanel Margin="8">

                        <styles:SHSubSection Title="What the wheelbase is being sent">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Gear" Width="90" />
                                    <TextBlock Text="{Binding OutputGear}" FontWeight="Bold" MinWidth="70" />
                                    <TextBlock Text="Shift up" Margin="12,0,4,0" />
                                    <TextBlock Text="{Binding OutputShiftUp}" MinWidth="50" />
                                    <TextBlock Text="Shift down" Margin="12,0,4,0" />
                                    <TextBlock Text="{Binding OutputShiftDown}" MinWidth="50" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Throttle" Width="90" />
                                    <ProgressBar Value="{Binding OutputThrottle, Mode=OneWay}" Maximum="100"
                                                 Width="240" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OutputThrottle, StringFormat=' {0} %'}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Brake" Width="90" />
                                    <ProgressBar Value="{Binding OutputBrake, Mode=OneWay}" Maximum="100"
                                                 Width="240" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OutputBrake, StringFormat=' {0} %'}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Clutch" Width="90" />
                                    <ProgressBar Value="{Binding OutputClutch, Mode=OneWay}" Maximum="100"
                                                 Width="240" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OutputClutch, StringFormat=' {0} %'}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Handbrake" Width="90" />
                                    <ProgressBar Value="{Binding OutputHandbrake, Mode=OneWay}" Maximum="100"
                                                 Width="240" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OutputHandbrake, StringFormat=' {0} %'}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </styles:SHSubSection>

                        <styles:SHSectionSeparator />

                        <styles:SHSubSection Title="Pedal port link">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="State" Width="90" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PedalLinkState}" FontWeight="Bold"
                                               VerticalAlignment="Center" MinWidth="180" />
                                    <styles:SHButtonSecondary Command="{Binding RearmPedalsCommand}">Re-arm handshake</styles:SHButtonSecondary>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="STREAMING means the wheelbase is accepting pedal data. The handshake can desync if the wheelbase is power-cycled or the adapter reboots; re-arming restarts it from step 0." />
                            </StackPanel>
                        </styles:SHSubSection>

                        <styles:SHSectionSeparator />

                        <styles:SHSubSection Title="H-pattern gear voltages">
                            <StackPanel>
                                <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="The H-pattern port reads a pair of voltages rather than a gear number, so each position is an (X, Y) DAC code from 0 to 4095. Adjust these if a gear won't register, and use Test to hold the position for half a second." />
                                <ItemsControl ItemsSource="{Binding GearDacs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Label}" Width="80" VerticalAlignment="Center" />
                                                <TextBlock Text="X" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding X}" Width="70" VerticalAlignment="Center" />
                                                <TextBlock Text="Y" Margin="10,0,4,0" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding Y}" Width="70" VerticalAlignment="Center" />
                                                <styles:SHLinkButtonSmall Margin="12,0,0,0"
                                                    Command="{Binding DataContext.TestGearCommand,
                                                        RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                    CommandParameter="{Binding Gear}">Test</styles:SHLinkButtonSmall>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </styles:SHSubSection>

                        <styles:SHSectionSeparator />

                        <styles:SHSubSection Title="Sequential pulse">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pulse width" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding PulseMs}" Width="70" VerticalAlignment="Center" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <styles:SHButtonSecondary Margin="16,0,0,0"
                                    Command="{Binding TestPulseCommand}" CommandParameter="up">Test up</styles:SHButtonSecondary>
                                <styles:SHButtonSecondary Margin="6,0,0,0"
                                    Command="{Binding TestPulseCommand}" CommandParameter="down">Test down</styles:SHButtonSecondary>
                            </StackPanel>
                        </styles:SHSubSection>

                        <styles:SHSectionSeparator />

                        <styles:SHSubSection Title="Test axes">
                            <StackPanel>
                                <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Drives one channel to a fixed value for half a second, then hands it back to the mapping. Useful for checking wiring without a foot on the pedal." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Throttle" Width="80" VerticalAlignment="Center" />
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="throttle:0" Margin="0,0,8,0">0 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="throttle:50" Margin="0,0,8,0">50 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="throttle:100">100 %</styles:SHLinkButtonSmall>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Brake" Width="80" VerticalAlignment="Center" />
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="brake:0" Margin="0,0,8,0">0 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="brake:50" Margin="0,0,8,0">50 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="brake:100">100 %</styles:SHLinkButtonSmall>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Clutch" Width="80" VerticalAlignment="Center" />
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="clutch:0" Margin="0,0,8,0">0 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="clutch:50" Margin="0,0,8,0">50 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="clutch:100">100 %</styles:SHLinkButtonSmall>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Handbrake" Width="80" VerticalAlignment="Center" />
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="handbrake:0" Margin="0,0,8,0">0 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="handbrake:50" Margin="0,0,8,0">50 %</styles:SHLinkButtonSmall>
                                    <styles:SHLinkButtonSmall Command="{Binding TestAxisCommand}" CommandParameter="handbrake:100">100 %</styles:SHLinkButtonSmall>
                                </StackPanel>
                            </StackPanel>
                        </styles:SHSubSection>

                    </StackPanel>
                </styles:SHTabItem>

                <styles:SHTabItem Header="Logs">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock VerticalAlignment="Center" Opacity="0.7"
                                       Text="Console output from the adapter (non-JSON lines)." />
                            <styles:SHLinkButtonSmall Command="{Binding ClearLogCommand}"
                                                      Margin="12,0,0,0">Clear</styles:SHLinkButtonSmall>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LogLines}"
                                 Height="320"
                                 FontFamily="Consolas"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </styles:SHTabItem>
            </styles:SHTabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
