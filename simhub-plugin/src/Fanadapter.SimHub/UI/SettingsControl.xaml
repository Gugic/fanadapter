<UserControl x:Class="Fanadapter.SimHub.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel>

            <styles:SHSection Title="ADAPTER" ShowSeparator="True">
                <TextBlock Text="Not connected." />
            </styles:SHSection>

            <styles:SHTabControl>
                <styles:SHTabItem Header="SimHub drive" />
                <styles:SHTabItem Header="Devices" />
                <styles:SHTabItem Header="Mappings" />
                <styles:SHTabItem Header="Outputs" />
                <styles:SHTabItem Header="Logs" />
            </styles:SHTabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
